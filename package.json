{
  "name": "bubblegum-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "images": "node scripts/images.mjs",
    "prebuild": "node scripts/images.mjs && node scripts/check-legal.mjs",
    "check:legal": "node scripts/check-legal.mjs",
    "datenfluss": "node scripts/datenfluss.mjs",
    "build": "next build && node scripts/postbuild.mjs",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "build:pages": "pnpm build",
    "brand-assets": "node scripts/brand-assets.mjs",
    "test:pages": "playwright test",
    "check:dashes": "node scripts/check-dashes.mjs",
    "screenshots:store": "node scripts/store-screenshots.mjs"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.2"
}
