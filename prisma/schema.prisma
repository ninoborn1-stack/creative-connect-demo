// Creative Connect – Datenmodell der Klick-Demo.
// SQLite kennt keine Enums und Listen: Status-Felder sind Strings (Werte in src/lib/constants.ts),
// Listen werden als JSON-String gespeichert. Für Postgres: provider ändern, Felder ggf. auf String[] / Json umstellen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String // Demo: Klartext "demo" – niemals so in Produktion
  name        String
  isAdmin     Boolean  @default(false)
  isCreative  Boolean  @default(false)
  isClient    Boolean  @default(false)
  status      String   @default("aktiv") // eingeladen | aktiv | verifiziert | gesperrt
  blockReason String?
  company     String? // für Auftraggeber:innen
  clientType  String? // Label | Marke | Agentur | Magazin | Independent-Artist
  onboarded   Boolean  @default(true)
  invitedById String?
  invitedBy   User?    @relation("InvitedBy", fields: [invitedById], references: [id])
  invitees    User[]   @relation("InvitedBy")
  createdAt   DateTime @default(now())

  profile          Profile?
  portfolio        PortfolioItem[]
  invitesSent      Invite[]         @relation("InviteSender")
  projectsOwned    Project[]        @relation("ProjectOwner")
  rolesFilled      ProjectRole[]
  requestsReceived Request[]
  messages         Message[]
  venues           Venue[]
  venueBookings    VenueBooking[]
  reviewsGiven     Review[]         @relation("ReviewAuthor")
  reviewsReceived  Review[]         @relation("ReviewTarget")
  credits          Credit[]
  rsvps            RSVP[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  equipment        EquipmentListing[]
  notifications    Notification[]
  profileViews     ProfileView[]    @relation("Viewed")
  viewed           ProfileView[]    @relation("Viewer")
  files            File[]
  payouts          Payment[]        @relation("PaymentPayee")
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String   @unique
  headline       String
  bio            String
  city           String
  state          String
  lat            Float
  lng            Float
  travelRadiusKm Int      @default(100)
  categories     String // JSON: Category-Slugs
  skills         String // JSON: string[]
  dayRateMin     Int
  dayRateMax     Int
  availability   String   @default("verfuegbar") // verfuegbar | teilweise | ausgebucht
  busyDates      String   @default("[]") // JSON: ISO-Daten
  isPro          Boolean  @default(false)
  verified       Boolean  @default(false)
  ratingAvg      Float    @default(0)
  ratingCount    Int      @default(0)
  instagram      String?
  website        String?
  taxIdProvided  Boolean  @default(false)
  kskMember      Boolean  @default(false)
  avatarSeed     String
  coverSeed      String
  // Sedcard (Schauspiel)
  heightCm       Int?
  hairColor      String?
  eyeColor       String?
  playingAge     String?
  languages      String?
  // Studio-Ausstattung (Tonstudio)
  equipment      String? // JSON: string[]
  topClientShare Int      @default(0) // Anteil größter Auftraggeber in % (Selbstständigkeits-Kennzahl)
  memberSince    DateTime @default(now())
}

model Category {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  sort        Int
}

model PortfolioItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // bild | audio | video | link
  title     String
  credits   String?
  imageSeed String?
  audioUrl  String?
  url       String?
  aiMarked  Boolean @default(false) // KI-generierte Inhalte kennzeichnen (AI Act Art. 50)
  sort      Int     @default(0)
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  senderId    String?
  sender      User?     @relation("InviteSender", fields: [senderId], references: [id])
  email       String?
  status      String    @default("offen") // offen | eingeloest | abgelaufen | freigabe
  expiresAt   DateTime
  redeemedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  email     String
  category  String
  city      String
  message   String?
  status    String   @default("wartend") // wartend | eingeladen | abgelehnt
  createdAt DateTime @default(now())
}

model Briefing {
  id         String   @id @default(cuid())
  rawText    String
  structured String // JSON: StructuredBriefing
  budget     Int
  startDate  DateTime?
  endDate    DateTime?
  location   String?
  style      String?
  createdAt  DateTime @default(now())
  project    Project?
}

model Project {
  id          String    @id @default(cuid())
  title       String
  description String
  type        String    @default("self") // self | managed
  status      String    @default("entwurf") // entwurf | anfragen | bestaetigt | produktion | abnahme | abgeschlossen | storniert
  managedStage String?  // anfrage | angebot | crew | produktion (Pipeline im Admin)
  budget      Int
  city        String
  startDate   DateTime
  endDate     DateTime
  coverSeed   String
  ownerId     String
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  briefingId  String?   @unique
  briefing    Briefing? @relation(fields: [briefingId], references: [id])
  createdAt   DateTime  @default(now())

  roles      ProjectRole[]
  requests   Request[]
  milestones Milestone[]
  messages   Message[]
  files      File[]
  contracts  Contract[]
  payments   Payment[]
  invoices   Invoice[]
  reviews    Review[]
  credits    Credit[]
  disputes   Dispute[]
}

model ProjectRole {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  category   String
  budget     Int
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id])
  sort       Int      @default(0)
  requests   Request[]
}

model Request {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleId      String
  role        ProjectRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  creativeId  String
  creative    User        @relation(fields: [creativeId], references: [id])
  status      String      @default("offen") // offen | angenommen | abgelehnt | gegenangebot | zurueckgezogen
  price       Int
  counterPrice Int?
  note        String?
  createdAt   DateTime    @default(now())
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime
  done      Boolean  @default(false)
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model File {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  name       String
  sizeKb     Int
  url        String
  createdAt  DateTime @default(now())
}

model Venue {
  id          String   @id @default(cuid())
  slug        String   @unique
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  type        String // tonstudio | fotostudio | location | proberaum
  description String
  city        String
  address     String
  features    String // JSON: string[]
  pricePerHour Int
  pricePerDay Int
  capacity    Int
  imageSeeds  String // JSON: string[]
  instantBook Boolean  @default(true)
  ratingAvg   Float    @default(0)
  bookings    VenueBooking[]
}

model VenueBooking {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  startHour Int
  endHour   Int
  fullDay   Boolean  @default(false)
  amount    Int
  status    String   @default("bestaetigt") // bestaetigt | storniert
  createdAt DateTime @default(now())
}

model Contract {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template     String // werkvertrag | nutzungsrechte | studiomiete | booking
  title        String
  partyA       String // Auftraggeber:in
  partyB       String // Auftragnehmer:in(nen)
  service      String
  usageRights  String
  compensation Int
  signedA      Boolean   @default(false)
  signedB      Boolean   @default(false)
  signedAName  String?
  signedBName  String?
  signedAt     DateTime?
  createdAt    DateTime  @default(now())
}

model Payment {
  id         String    @id @default(cuid())
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payeeId    String?
  payee      User?     @relation("PaymentPayee", fields: [payeeId], references: [id])
  label      String
  amount     Int // Honorar netto in EUR
  serviceFee Int // 10 % Servicegebühr Auftraggeber
  margin     Int       @default(0) // Managed-Crew-Marge
  status     String    @default("reserviert") // reserviert | freigegeben | ausgezahlt | erstattet
  providerRef String // Mock-Referenz des Zahlungsdienstleisters
  createdAt  DateTime  @default(now())
  releasedAt DateTime?
  paidOutAt  DateTime?
}

model Invoice {
  id        String   @id @default(cuid())
  number    String   @unique
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issuer    String
  recipient String
  items     String // JSON: {label, amount}[]
  net       Int
  vatRate   Int      @default(19)
  issuedAt  DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating    Int
  text      String
  createdAt DateTime @default(now())
}

model Credit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String // Projekttitel (auch für externe Credits)
  role      String
  year      Int
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  date        DateTime
  city        String
  venueName   String
  imageSeed   String
  capacity    Int
  rsvps       RSVP[]
}

model RSVP {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Post {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  imageSeed String?
  createdAt DateTime  @default(now())
  comments  Comment[]
  likes     Like[]
}

model Like {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  teaser    String
  body      String // Markdown-light: Absätze getrennt durch Leerzeile, "## " für Zwischenüberschriften
  category  String
  readMin   Int
  imageSeed String
  createdAt DateTime @default(now())
}

model EquipmentListing {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  description String
  mode      String // verleih | verkauf
  price     Int // pro Tag bei Verleih, Gesamtpreis bei Verkauf
  city      String
  condition String
  imageSeed String
  createdAt DateTime @default(now())
}

model ProfileView {
  id        String   @id @default(cuid())
  viewedId  String
  viewed    User     @relation("Viewed", fields: [viewedId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    User     @relation("Viewer", fields: [viewerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OutboxMail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model Dispute {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  openedBy   String
  reason     String
  status     String    @default("offen") // offen | in_pruefung | geloest
  resolution String? // freigegeben | erstattet | teilerstattet
  log        String    @default("[]") // JSON: {at, by, text}[]
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String
  detail    String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model KpiSnapshot {
  id              String @id @default(cuid())
  month           String @unique // JJJJ-MM
  activeMembers   Int
  newInvites      Int
  volume          Int
  serviceFees     Int
  proSubs         Int
  managedMargin   Int
  projectsStarted Int
}
